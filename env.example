# Copy this file to .env and fill it in. Never share or commit .env.

# ---- Collection (Whales of WhaleStreet on Robinhood Chain) ----
CONTRACT_ADDRESS=0x01f33271d74a9dcc91798c7232d3d788da93a1f6
COLLECTION_NAME=Whale Street
EMOJI=🐳

# ---- X (Twitter) API keys: developer.x.com -> your app -> "Keys and tokens" ----
# The Access Token must be generated while logged in as the BOT account, with
# "Read and write" permission (regenerate it after changing permissions).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# true = print posts instead of posting them.
# Set to false once `python bot.py --check` passes.
DRY_RUN=true
